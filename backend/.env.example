# Copy to backend/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# Leave DATABASE_URL blank for local SQLite development.
# Hosted Turso/libSQL example:
# DATABASE_URL=libsql://your-database-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token
DATABASE_URL=
DATABASE_AUTH_TOKEN=

ARC_NETWORK=arc-testnet
ARC_RPC=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app
ARC_USDC_TOKEN=0x3600000000000000000000000000000000000000

# Exact frontend origin; comma-separated if multiple trusted origins are needed.
CORS_ORIGINS=http://localhost:3000

# Optional: leave blank to disable real AI provider calls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
